# Maestro test credentials
#
# Copy to `.maestro/.env` and fill in real values. .env is gitignored.
# Source it before running flows:
#
#   set -a; source .maestro/.env; set +a
#   maestro test .maestro/flows/
#
# Or pass per-run:
#   maestro test -e MAESTRO_TEST_NAME="..." -e MAESTRO_TEST_PASSWORD="..." .maestro/flows/login.yaml

MAESTRO_TEST_NAME="Test Employee"
MAESTRO_TEST_PASSWORD="change-me"
